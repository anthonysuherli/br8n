{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.anthonysuherli/br8n",
  "description": "Capture dev context on interrupt; replay it as a 30-second resume card. Git stash for your head.",
  "version": "1.1.2",
  "websiteUrl": "https://anthonysuherli.github.io/br8n/",
  "repository": {
    "url": "https://github.com/anthonysuherli/br8n",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "br8n",
      "version": "1.1.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--from"
        },
        {
          "type": "positional",
          "value": "br8n"
        },
        {
          "type": "positional",
          "value": "br8n-mcp"
        }
      ]
    }
  ]
}
